{
  "manifest_version": 3,
  "name": "YT History Downloader",
  "version": "0.3.0",
  "description": "Select videos on your YouTube history page and download them as video or audio using a local yt-dlp helper.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
